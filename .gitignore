# Local Claude state stays out, but the backlog commands are the system's
# guardrails (what the nightly routine may merge, what it must never touch) and
# have to be versioned.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/backlog*.md

# Obsidian "Smart Connections" data — contains private note paths/metadata.
# Must never be published. (Removed from the repo during the security review.)
.smart-env/
content/.smart-env/

# Playwright regression-rig local outputs (grocery app). CI uploads these as
# build artifacts; they're generated, never committed.
tests/grocery/screenshots/
tests/grocery/test-results/
tests/grocery/playwright-report/
tests/install-checks/test-results/
tests/install-checks/playwright-report/
tests/bank-bonus/test-results/
tests/bank-bonus/playwright-report/
tests/pool/test-results/
tests/pool/playwright-report/

# Studio local editor: safety net copies + soft-deleted pages. Never published.
.studio-backups/
.studio-trash/

# Generated snapshot of the GitHub backlog (Backlog.command). Not source.
BACKLOG.md
backlog/__pycache__/
