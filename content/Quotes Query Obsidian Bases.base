views:
  - type: cards
    name: Cards
    filters:
      and:
        - file.hasTag("quote")
    order:
      - file.name
      - tags
      - source
      - created
      - file.backlinks
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 478
    imageFit: ""
    imageAspectRatio: 1.1
    cardSize: 420
