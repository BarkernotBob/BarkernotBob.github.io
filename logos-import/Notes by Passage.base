filters:
  and:
    - source == "logos"
formulas:
  book: file.folder
properties:
  note.passages:
    displayName: Passages
  note.notebook:
    displayName: Notebook
  note.passage_sort:
    displayName: Order
  note.updated:
    displayName: Updated
views:
  - type: table
    name: Notes by Passage
    order:
      - file.name
      - note.passages
      - note.notebook
      - note.updated
    sort:
      - property: note.passage_sort
        direction: ASC
  - type: table
    name: Grouped by Book
    groupBy:
      property: formula.book
      direction: ASC
    order:
      - file.name
      - note.passages
      - note.notebook
    sort:
      - property: note.passage_sort
        direction: ASC
  - type: list
    name: Recently Updated
    order:
      - file.name
      - note.updated
    sort:
      - property: note.updated
        direction: DESC
    limit: 25
